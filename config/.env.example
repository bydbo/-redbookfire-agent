# 小红书热点搭子 · 密钥模板
# 用法：复制为 config/.env 并填入真实值。
# config/.env 已被 .gitignore 忽略，永不入库。
# 【现状】改造落地前，当前代码在密钥为空时会走离线规则引擎。
# 【目标】企业化改造后取消该降级路径：缺密钥、缺数据库或缺队列将直接启动失败。

# 文本模型密钥（默认 DeepSeek 兼容接口）
DEEPSEEK_API_KEY=

# 多模态模型密钥（素材抽帧打标，默认通义千问 VL）
DASHSCOPE_API_KEY=

# 以下为可选覆盖项，优先级高于 config.toml，一般无需修改
# XHS_LLM_PROVIDER=auto
# XHS_LLM_BASE_URL=https://api.deepseek.com/v1
# XHS_LLM_MODEL=deepseek-flash
# XHS_LLM_API_KEY=

# 【待落地】以下变量在企业化改造落地后成为必填项；全集、校验规则与缺失行为见 docs/contracts/配置契约.md
# DATABASE_URL=postgresql+asyncpg://xhs:xhs@localhost:5432/xhs
# REDIS_URL=redis://localhost:6379/0

# 【待落地】可观测三件套，三者齐全才启用调用追踪，不齐只告警不阻断
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# 【待落地】嵌入模型覆盖项（默认通义 text-embedding-v3）
# XHS_EMBEDDING_MODEL=