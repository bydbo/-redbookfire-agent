# 小红书热点搭子 · 密钥模板
# 用法：复制为 config/.env 并填入真实值；config/.env 已被 .gitignore 忽略，永不入库。
# 变量全集、必填阶段与校验规则见 docs/contracts/配置契约.md 第二节。
# 本文件只放变量名与空值；密钥不进 config/config.toml，也不进任何会被提交的文件。
# 启动前置检查：uv run python -m xhs_agent.probe（缺必填项以退出码 2 失败，不做降级）

# --- P1 起必填：文本模型密钥（默认 DeepSeek 兼容接口）---
DEEPSEEK_API_KEY=

# --- 能力启用即必填：多模态打标与向量召回 ---
# [embedding].enabled 默认 true（向量召回是产品主线），所以本变量默认必填；
# 把 [vision].enabled 与 [embedding].enabled 都关掉后就不再要求。
# 变量名可由 [vision].api_key_env / [embedding].api_key_env 改写。
DASHSCOPE_API_KEY=

# --- P2 起必填：数据库连接串（必须以 postgresql+asyncpg:// 开头）---
DATABASE_URL=postgresql+asyncpg://xhs:xhs@localhost:5432/xhs

# --- P3 起必填：队列与缓存连接串（必须以 redis:// 或 rediss:// 开头）---
# REDIS_URL=redis://localhost:6379/0

# --- 可观测三件套：三者齐全才启用调用追踪，不齐只告警不阻断（S4.2 接线）---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# --- 可选覆盖项：优先级高于 config.toml，一般无需修改 ---
# XHS_LLM_PROVIDER=openai_compatible
# XHS_LLM_BASE_URL=https://api.deepseek.com/v1
# XHS_LLM_MODEL=deepseek-flash
# XHS_LLM_API_KEY=
# XHS_EMBEDDING_MODEL=text-embedding-v3
# XHS_LOG_LEVEL=INFO
# XHS_CONFIG_PATH=config/config.toml
