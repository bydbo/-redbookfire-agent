# 蹭点 · 密钥模板
# 用法：复制为 config/.env 并填入真实值。
# config/.env 已被 .gitignore 忽略，永不入库。
# 全部留空也能跑：系统会自动降级到离线规则引擎（无需任何密钥即可跑通全链路）。

# 文本模型密钥（默认 DeepSeek 兼容接口）
DEEPSEEK_API_KEY=

# 多模态模型密钥（素材抽帧打标，默认通义千问 VL）
DASHSCOPE_API_KEY=

# 以下为可选覆盖项，优先级高于 config.toml，一般无需修改
# XHS_LLM_PROVIDER=auto
# XHS_LLM_BASE_URL=https://api.deepseek.com/v1
# XHS_LLM_MODEL=deepseek-chat
# XHS_LLM_API_KEY=
