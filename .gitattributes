# 源码与文档统一 LF，避免 Windows 下的行尾噪音
* text=auto eol=lf

# 二进制媒体文件
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.bmp binary
*.heic binary
*.mp4 binary
*.mov binary
*.mkv binary
*.avi binary
*.webm binary
*.flv binary
*.m4v binary
*.mp3 binary
*.wav binary
*.m4a binary
*.flac binary

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
