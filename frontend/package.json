{
  "name": "xhs-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "25.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.vitest.json",
    "gen:api": "openapi-typescript ../docs/contracts/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "pnpm run gen:api && git diff --exit-code -- src/api/schema.d.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.0.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.0.0"
  }
}
